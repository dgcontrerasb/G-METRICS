# ==============================================================================
# VARIABLES DE ENTORNO - SPORTSTATS PRO (Configurar en el panel de Vercel)
# ==============================================================================

# 1. Seguridad Zero Trust y Panel de Administración
# Define tu PIN privado de administrador para ingresar al panel
ADMIN_PIN="tu_pin_admin_aqui"

# Número de WhatsApp oficial de atención (código de país + número, ej. 573001234567)
ADMIN_WHATSAPP="tu_numero_whatsapp_aqui"

# [OPCIONALES DE ENDURECIMIENTO EN PRODUCCIÓN - Ya cuentan con respaldo criptográfico automático en el servidor]
# No necesitas solicitarlos a ningún proveedor externo; son llaves internas tuyas.
# Descomenta en Vercel solo si deseas personalizar las firmas criptográficas por defecto:
# ADMIN_MASTER_KEY="MASTER-2708"
# JWT_SECRET_KEY="SPORTSTATS_PRO_ZERO_TRUST_JWT_HMAC_KEY_2026_V4"
# LICENSE_MASTER_SECRET="FUTSTATS_PRO_MASTER_SECRET_KEY_2025_V3"
# ALLOWED_ORIGINS="https://tu-dominio.vercel.app"

# 2. Base de Datos Supabase (Gratuita - supabase.com)
# Configura estas variables en tu entorno para persistencia en la nube
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 3. Claves de APIs Deportivas (Almacenadas solo en el servidor, nunca expuestas al cliente)
# API-Football (v3 - api-sports.io)
API_FOOTBALL_KEY=""

# Football-Data.org (Clasificaciones oficiales y H2H)
FOOTBALL_DATA_KEY=""

# The Odds API (Cuotas en tiempo real y detección de Valor Esperado +EV)
ODDS_API_KEY=""

# 4. Opcionales de Plataforma
GEMINI_API_KEY=""
APP_URL=""
